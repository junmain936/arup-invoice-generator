# ── Firebase (Firestore) connection ──
# Firebase Console → Project Settings → Service accounts → Generate new private key
# JSON file se ye 3 values nikalo:
#   project_id    → FIREBASE_PROJECT_ID
#   client_email  → FIREBASE_CLIENT_EMAIL
#   private_key   → FIREBASE_PRIVATE_KEY (poori value, \n sameet, quotes me)
#
# (Local me test karna ho to is file ko ".env.local" naam se copy karo.
#  Vercel par deploy hai to Vercel → Project → Settings → Environment Variables me dalo.)

FIREBASE_PROJECT_ID=arup-invoice
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@arup-invoice.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# ── Setup steps (detail me: firestore-setup.md dekho) ──
# 1. console.firebase.google.com par project banao
# 2. Firestore Database banao (production mode, asia-south1)
# 3. Rules tab me firestore-setup.md wale rules paste karke Publish karo
# 4. Service account JSON se upar wali 3 values nikalo
# 5. Yahan (ya Vercel env vars me) set karo → restart/redeploy
# 6. App me "↻ DB Sync 🟢" dikhe = database connected ✅
